{
    "format": "transcend-layout",
    "version": 1,
    "name": "Stage",
    "layout": {
        "mainSplitterOrder": ["browser", "trackHeaders", "timeline", "assets"],
        "mainSplitterSizes": [300, 180, 1080, 260],
        "browserVisible": true,

        "pianoRollDockOpen": true,
        "pianoRollDockHeight": 280,
        "centerSplitterSizes": [560, 280],
        "mixerOpen": false,
        "stepSequencerOpen": false,
        "workspacePage": "timeline",

        "leftSidebarTab": 1,
        "rightSidebarTab": 0,
        "browserPath": ["Extensions", "Layouts"],

        "headerLeft":   ["menus", "lcd"],
        "headerCenter": ["transport.restart", "transport.play", "transport.record", "transport.mode", "tools"],
        "headerRight":  ["view.timeline", "view.pianoRoll", "view.stepSequencer", "view.mixer", "view.pads",
                         "separator", "view.history", "view.customize", "status"],

        "patternsHeader": ["patterns.new"],
        "samplesHeader":  ["samples.search"],
        "filesHeader":    ["files.addFolder"],
        "mixerToolbar":   ["mixer.viewState", "mixer.close"],

        "bareButtons": ["view.timeline", "view.pianoRoll", "view.stepSequencer", "view.mixer", "view.pads",
                        "view.history", "view.customize"]
    }
}
